# Razorpay test-mode credentials. Leave unset to run against the built-in mock
# payment executor (deterministic fake orders/webhooks, no network calls).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SQLite by default; point at a Postgres DSN for a closer-to-prod setup.
DATABASE_URL=sqlite:///./firewall.db

# Mandate validity window used by the /intent/compile stub, in minutes.
DEFAULT_MANDATE_TTL_MINUTES=20

# POST /agent/request admission, per API worker. All values must be positive.
AGENT_RATE_LIMIT=60
AGENT_RATE_LIMIT_GLOBAL=600
AGENT_RATE_LIMIT_WINDOW_SECONDS=60
AGENT_RATE_LIMIT_MAX_CLIENTS=4096

# Flag CREATED orders without webhooks as STALE after 30 minutes.
PAYMENT_STALE_AFTER_SECONDS=1800
PAYMENT_CLEANUP_INTERVAL_SECONDS=60
PAYMENT_CLEANUP_BATCH_SIZE=100
