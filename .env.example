# Razorpay test-mode credentials. Leave unset to run against the built-in mock
# payment executor (deterministic fake orders/webhooks, no network calls).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SQLite by default; point at a Postgres DSN for a closer-to-prod setup.
DATABASE_URL=sqlite:///./firewall.db

# Mandate validity window used by the /intent/compile stub, in minutes.
DEFAULT_MANDATE_TTL_MINUTES=20
